{
    "name": "antonowano/chat",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Ivan Antonov",
            "email": "antonowano@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Antonowano\\Chat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Antonowano\\Chat\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "symfony/clock": "^8.1"
    },
    "scripts": {
        "test": "pest"
    },
    "scripts-descriptions": {
        "unit": "Runs unit tests"
    },
    "require-dev": {
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-drift": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
